              RowBox[{"d", "-", "3"}], ")"}], "/", "2"}], ")"}]}], "+", "p"}],
          ")"}]}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Pi]", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"d", "-", "3"}], ")"}], "/", "2"}], ")"}]}]}], ")"}], "/", 
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"4", "-", "s"}], ")"}], "/", "4"}], "]"}]}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"\[Sigma]", "-", "4"}], "]"}], "-", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"4", "-", "s"}], "]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"\[Sigma]", "-", "4"}], "]"}], "+", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"4", "-", "s"}], "]"}]}], ")"}]}], ")"}], "^", "2"}]}], "/.", 
      RowBox[{"\[Sigma]", "->", "8"}]}], ",", "True", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", "-", "s"}], ")"}], "^", "p"}]}], "]"}]}], ";"}], "\n", 
