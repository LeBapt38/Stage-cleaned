      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"root1", ",", "root2"}], "}"}], "=", 
        RowBox[{"{", 
         RowBox[{"root2", ",", 
          RowBox[{"secantOrder2", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"myFunc", "[", 
              RowBox[{"JJ", ",", "#"}], "]"}], "&"}], ",", "root1", ",", 
            "100", ",", 
            SuperscriptBox["10", 
             RowBox[{"-", "10"}]]}], "]"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"JJ", ",", "root2"}], "}"}]}], ",", 
      RowBox[{"{", 
