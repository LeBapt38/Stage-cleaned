  RowBox[{"(*", " ", 
   RowBox[{"wavelet", " ", "centers", " ", "grid"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]g", "[", "n_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"j", "=", "1"}], ",", "temp", ",", "exit", ",", "previous", ",",
        "out"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"previous", "=", 
       RowBox[{"\[Sigma]g", "[", 
        RowBox[{"n", "-", "1"}], "]"}]}], ";", "\n", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", "100"}], ",", 
        RowBox[{"i", "++"}], ",", "\n", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<=", 
            RowBox[{"Length", "[", 
             RowBox[{"sg", "[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"j", "++"}], ",", "\n", 
           RowBox[{
            RowBox[{"temp", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"sg", "[", "i", "]"}], "[", 
               RowBox[{"[", "j", "]"}], "]"}], "//", "Re"}]}], ";", "\n", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"MemberQ", "[", 
                RowBox[{"previous", ",", "temp"}], "]"}]}], ",", 
              RowBox[{"Goto", "[", "exit", "]"}]}], "]"}], ";"}]}], "\n", 
          "]"}], ";"}]}], "\n", "]"}], ";", "\n", 
      RowBox[{"Return", "[", "\"\<\[Sigma]g error ...\>\"", "]"}], ";", "\n", 
      
      RowBox[{"Abort", "[", "]"}], ";", "\n", 
      RowBox[{"Label", "[", "exit", "]"}], ";", "\n", 
      RowBox[{"out", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"previous", ",", "temp"}], "}"}], "//", "Flatten"}], "//", 
        "Sort"}]}], ";", "\n", 
      RowBox[{"Return", "[", 
