      RowBox[{
       RowBox[{"CompactIntegrand", "[", 
        RowBox[{"#", ",", "z", ",", 
         RowBox[{"z0t", "[", "s", "]"}]}], "]"}], "&"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", "0", ",", "\[Pi]"}], "}"}], ",", "p0"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"exprJmain2", "[", 
