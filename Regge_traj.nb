Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"trackZeroJplane", "[", 
    RowBox[{
    "myFunc_", ",", "start_", ",", "smin_", ",", "smax_", ",", "ds_"}], "]"}],
    ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"root", "=", "start"}], "}"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"root", "=", 
         RowBox[{"secantOrder2", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"myFunc", "[", 
             RowBox[{"#", ",", 
              RowBox[{"s", "+", 
               RowBox[{
                RowBox[{"10", "^", 
                 RowBox[{"-", "16"}]}], " ", "I"}]}]}], "]"}], "&"}], ",", 
           "root"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"s", ",", "root"}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "smin", ",", "smax", ",", "ds"}], "}"}]}], "]"}]}], 
    "]"}]}], 
  RowBox[{"(*", 
   RowBox[{
   "Track", " ", "a", " ", "zero", " ", "when", " ", "increasing", " ", "s", " ",
     "by", " ", "small", " ", 
    RowBox[{"step", ".", " ", "The"}], " ", "roots", " ", "of", " ", 
    "previous", " ", "step", " ", "is", " ", "used", " ", "as", " ", 
    "starting", " ", "point", " ", "for", " ", "next", " ", 
    RowBox[{"one", "."}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trackZeroSplane", "[", 
