Cell[CellGroupData[{

Cell["Secant algorithm", "Section",
 CellChangeTimes->{{3.991750795557665*^9, 
  3.9917508005067453`*^9}},ExpressionUUID->"1687a6c3-0b91-4b4c-b358-\
650d9e9d398f"],

Cell["\<\
Use secant method of order 2 for optimised computation (one integral per \
step). First order method to get 3rd point of initialisation.\
\>", "Text",
 CellChangeTimes->{{3.991750848408045*^9, 
  3.991750915134922*^9}},ExpressionUUID->"5f847a7e-d020-440c-9cad-\
e5b79c7ff628"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "secantOrder2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"secantOrder2", "[", 
    RowBox[{"myFunc_", ",", "start_", ",", 
     RowBox[{"nmax_", ":", "100"}], ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "x0", ",", "x1", ",", "x2", ",", " ", "x3", ",", "i", ",", "a", ",", 
       "b", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"x0", "=", "start"}], ";", "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{"myFunc", "[", "x0", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x1", " ", "=", " ", 
       RowBox[{"start", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "I"}], ")"}], 
         SuperscriptBox["10", 
          RowBox[{"-", "4"}]]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"myFunc", "[", "x1", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x2", "=", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x1", " ", "b"}], "-", 
          RowBox[{"x0", " ", "c"}]}], ")"}], 
        RowBox[{"b", "-", " ", "c"}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{"i", "=", "0"}], ";", "\[IndentingNewLine]", "\n", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "=", "b"}], ";", "\[IndentingNewLine]", 
         RowBox[{"b", "=", "c"}], ";", "\[IndentingNewLine]", 
         RowBox[{"c", "=", 
          RowBox[{"myFunc", "[", "x2", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "c", "]"}], ">", "tol"}], "&&", 
          RowBox[{"i", "<", "nmax"}], "&&", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"i", "<", "8"}], "||", 
            RowBox[{
             RowBox[{"Abs", "[", "b", "]"}], ">", 
             RowBox[{"Abs", "[", "c", "]"}]}]}], ")"}], "&&", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"x2", "-", "start"}], "]"}], "<", "5"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"i", "=", 
          RowBox[{"i", "+", "1"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Guard", " ", "against", " ", "duplicate", " ", "function", " ", 
           RowBox[{"values", "/", "zero"}], " ", "denominators"}], "*)"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"a", "-", "b"}], "]"}], "<", 
             RowBox[{"10", "^", 
              RowBox[{"-", "15"}]}]}], "||", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"b", "-", "c"}], "]"}], "<", 
             RowBox[{"10", "^", 
              RowBox[{"-", "15"}]}]}], "||", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"a", "-", "c"}], "]"}], "<", 
             RowBox[{"10", "^", 
              RowBox[{"-", "15"}]}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"x2", "=", 
             RowBox[{"x2", "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", "I"}], ")"}], "*", 
               RowBox[{"10", "^", 
                RowBox[{"-", "5"}]}]}]}]}], ";", 
            RowBox[{"(*", 
             RowBox[{"Perturb", " ", "slightly", " ", "if", " ", "stuck"}], 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{"c", "=", 
             RowBox[{"myFunc", "[", "x2", "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"x3", "=", 
          RowBox[{
           FractionBox[
            RowBox[{"x0", " ", "b", " ", "c"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"a", "-", "b"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"a", "-", "c"}], ")"}]}]], "+", 
           FractionBox[
            RowBox[{"x1", " ", "a", " ", "c"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"b", "-", "a"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"b", "-", "c"}], ")"}]}]], "+", 
           FractionBox[
            RowBox[{"x2", " ", "a", " ", "b"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"c", "-", "a"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"c", "-", "b"}], ")"}]}]]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"x0", "=", "x1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"x1", "=", "x2"}], ";", "\[IndentingNewLine]", 
         RowBox[{"x2", "=", "x3"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"x2", "-", "start"}], "]"}], ">", "5"}], ",", 
        RowBox[{
         RowBox[{"Print", "[", "\"\<failed point\>\"", "]"}], ";", 
         RowBox[{"x2", "=", "start"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      "x2"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9893819945914288`*^9, 3.989382035142722*^9}, {
   3.9893821278292217`*^9, 3.989382509371237*^9}, {3.9893825984029217`*^9, 
