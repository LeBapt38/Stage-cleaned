Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MyNIntegrateFaster", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "a_", ",", "b_"}], "}"}], ",", "p_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
