       RowBox[{"CompactIntegrand", "[", 
        RowBox[{"#", ",", "z", ",", 
         RowBox[{"z0u", "[", "s", "]"}]}], "]"}], "&"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", "0", ",", "\[Pi]"}], "}"}], ",", "p0"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"exprJkeyhole", ",", "exprJthresh"}], "]"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Definition", " ", "of", " ", "the", " ", "function", " ", "computing", " ",
     "the", " ", "divergent", " ", "threshold", " ", "terms", " ", "when", " ",
     "n", " ", "half", " ", "integer"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exprJkeyhole", "[", 
     RowBox[{"J_", ",", "s_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "div", ",", "divT", ",", "exprSTU", ",", "expr", ",", "DiscExprT", ",",
         "exprJmain", ",", "exprJkeyhole1"}], "}"}], ",", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{"div", "[", "ss_", "]"}], ":=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"4", "-", "ss"}], ")"}], "^", 
         RowBox[{"-", "n"}]}]}], ";", "\n", 
       RowBox[{
        RowBox[{"divT", "[", "ss_", "]"}], ":=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "^", "n"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"ss", "-", "4"}], ")"}], "^", 
          RowBox[{"-", "n"}]}]}]}], ";", "\n", 
       RowBox[{
        RowBox[{"exprSTU", "[", 
         RowBox[{"ss_", ",", "t_", ",", "u_"}], "]"}], ":=", 
        RowBox[{
         RowBox[{"div", "[", "ss", "]"}], "+", 
         RowBox[{"div", "[", "u", "]"}], "+", 
         RowBox[{"div", "[", "t", "]"}]}]}], ";", "\n", 
       RowBox[{
        RowBox[{"expr", "[", 
         RowBox[{"ss_", ",", "z_"}], "]"}], ":=", 
        RowBox[{"exprSTU", "[", 
         RowBox[{"ss", ",", " ", 
          RowBox[{"tt", "[", 
           RowBox[{"ss", ",", "z"}], "]"}], ",", 
          RowBox[{"uu", "[", 
           RowBox[{"ss", ",", "z"}], "]"}]}], "]"}]}], ";", "\n", 
       RowBox[{
        RowBox[{"DiscExprT", "[", 
         RowBox[{"ss_", ",", "z_"}], "]"}], ":=", 
        RowBox[{"divT", "[", 
         RowBox[{"tt", "[", 
          RowBox[{"ss", ",", "z"}], "]"}], "]"}]}], ";", "\n", 
       RowBox[{
        RowBox[{"exprJmain", "[", 
         RowBox[{"JJ_", ",", "ss_"}], "]"}], ":=", 
        RowBox[{"MyNIntegrateFaster", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"PolQ", "[", 
              RowBox[{"JJ", ",", "d", ",", "z"}], "]"}], 
             RowBox[{"DiscExprT", "[", 
              RowBox[{"ss", ",", "z"}], "]"}]}], ")"}], "//", 
           RowBox[{
            RowBox[{"CompactIntegrand", "[", 
             RowBox[{"#", ",", "z", ",", 
              RowBox[{
               RowBox[{"z0t", "[", "ss", "]"}], "+", 
               RowBox[{
                RowBox[{"Exp", "[", 
                 RowBox[{"I", " ", 
                  RowBox[{"Arg", "[", 
                   RowBox[{
                    RowBox[{"-", "1"}], "+", 
                    RowBox[{"z0t", "[", "ss", "]"}]}], "]"}]}], "]"}], 
                RowBox[{"epsilonT", "[", 
                 RowBox[{"JJ", ",", "ss"}], "]"}]}]}]}], "]"}], "&"}]}], ",", 
          
          RowBox[{"{", 
           RowBox[{"\[Phi]", ",", "0", ",", "\[Pi]"}], "}"}], ",", "p0"}], 
         "]"}]}], ";", "\n", 
       RowBox[{
        RowBox[{"exprJkeyhole1", "[", 
         RowBox[{"JJ_", ",", " ", "ss_", ",", " ", 
          RowBox[{"ord_", ":", " ", "4"}]}], "]"}], " ", ":=", " ", 
        RowBox[{"Module", "[", "\n", "\t  ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "z0", ",", " ", "dir", ",", " ", "eps", ",", " ", "\[Alpha]", ",", 
            " ", "c0", ",", " ", "qk"}], "}"}], ",", "\n", "\t  ", 
          RowBox[{
           RowBox[{"z0", "  ", "=", " ", 
            RowBox[{"z0t", "[", "ss", "]"}]}], ";", "\n", "\t  ", 
           RowBox[{"dir", " ", "=", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", " ", 
              RowBox[{"Arg", "[", 
               RowBox[{"z0", " ", "-", " ", "1"}], "]"}]}], "]"}]}], ";", 
           "   ", 
           RowBox[{"(*", " ", 
            RowBox[{"direction", " ", "of", " ", "the", " ", 
             RowBox[{"cut", " ", "/", " ", "keyhole"}], " ", "ray"}], " ", 
            "*)"}], "\n", "\t  ", 
           RowBox[{"eps", " ", "=", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "5"}]}]}], ";", "\n", "\t  ", 
           RowBox[{"\[Alpha]", "   ", "=", " ", "n"}], " ", ";", "\n", "\t  ", 
           RowBox[{"(*", " ", 
            RowBox[{
