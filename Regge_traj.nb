       RowBox[{"SetPrecision", "[", 
        RowBox[{"temp", ",", "p"}], "]"}]}], ";", "\n", 
      RowBox[{"Return", "[", "temp", "]"}], ";"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
