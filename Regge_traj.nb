Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Finds", " ", "the", " ", "minimums", " ", "of", " ", "a", " ", "function",
     " ", "on", " ", "a", " ", 
    RowBox[{"grid", ".", " ", "Used"}], " ", "to", " ", "initialise", " ", 
    "the", " ", "secant", " ", 
    RowBox[{"method", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"minPtsFromGraph", "[", "data_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "pts", ",", "coords", ",", "vals", ",", "nf", ",", "k", ",", "xmin", ",",
        "xmax", ",", "ymin", ",", "ymax", ",", "margin", ",", "interiorQ", ",",
        "mins", ",", "depthThreshold", ",", "minPts"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pts", "=", 
       RowBox[{"data", "/.", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], ":>", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", 
           RowBox[{"Log", "[", 
            RowBox[{"Abs", "[", "z", "]"}], "]"}]}], "}"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"coords", "=", 
       RowBox[{"pts", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"1", ";;", "2"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vals", "=", 
       RowBox[{"pts", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"nf", "=", 
       RowBox[{"Nearest", "[", 
        RowBox[{"coords", "->", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "coords", "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"k", "=", "15"}], ";", "\[IndentingNewLine]", 
      RowBox[{"xmin", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"coords", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xmax", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"coords", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ymin", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"coords", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ymax", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"coords", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"margin", "=", "0.21"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"interiorQ", "[", 
        RowBox[{"{", 
         RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"xmin", "+", "margin"}], "<", "x", "<", 
         RowBox[{"xmax", "-", "margin"}]}], "&&", 
        RowBox[{
         RowBox[{"ymin", "+", "margin"}], "<", "y", "<", 
         RowBox[{"ymax", "-", "margin"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mins", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "pts", "]"}], "]"}], ",", 
         RowBox[{"Function", "[", 
          RowBox[{"i", ",", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"neigh", ",", "v"}], "}"}], ",", 
             RowBox[{
              RowBox[{"neigh", "=", 
               RowBox[{"DeleteCases", "[", 
                RowBox[{
                 RowBox[{"nf", "[", 
                  RowBox[{
                   RowBox[{"coords", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "k"}], "]"}], ",", 
                 "i"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"v", "=", 
               RowBox[{"vals", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              
              RowBox[{
               RowBox[{"interiorQ", "[", 
                RowBox[{"coords", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "&&", 
               RowBox[{"AllTrue", "[", 
                RowBox[{
                 RowBox[{"vals", "[", 
                  RowBox[{"[", "neigh", "]"}], "]"}], ",", 
                 RowBox[{
                  RowBox[{"#", ">=", "v"}], "&"}]}], "]"}]}]}]}], "]"}]}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"minPts", "=", 
       RowBox[{"pts", "[", 
        RowBox[{"[", "mins", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"depthThreshold", "=", "0.6"}], ";", "\[IndentingNewLine]", 
      RowBox[{"minPts", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"minPts", ",", 
         RowBox[{"Function", "[", 
          RowBox[{"p", ",", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"neigh", ",", "localVals"}], "}"}], ",", 
             RowBox[{
              RowBox[{"localVals", "=", 
               RowBox[{"vals", "[", 
                RowBox[{"[", 
                 RowBox[{"DeleteCases", "[", 
                  RowBox[{
                   RowBox[{"nf", "[", 
                    RowBox[{
                    RowBox[{"p", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ";;", "2"}], "]"}], "]"}], ",", "k"}], "]"}],
                    ",", 
                   RowBox[{"First", "@", 
                    RowBox[{"nf", "[", 
                    RowBox[{
                    RowBox[{"p", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ";;", "2"}], "]"}], "]"}], ",", "1"}], 
                    "]"}]}]}], "]"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"Mean", "[", "localVals", "]"}], "-", 
                RowBox[{"p", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], ">", 
               "depthThreshold"}]}]}], "]"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "minPts"}]}], "]"}]}]}]], "Input",
