Cell[CellGroupData[{

Cell["Tools FG", "Section",ExpressionUUID->"ccc268d2-46f8-4ceb-a5d7-e6c9f5e1c4af"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PolQ", "[", 
    RowBox[{"J_", ",", " ", "d_", ",", " ", "z_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"4", "/", "Pi"}], ")"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sqrt", "[", "Pi", "]"}], 
       RowBox[{"Gamma", "[", 
        RowBox[{"J", "+", "1"}], "]"}], 
       RowBox[{"Gamma", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"d", "-", "2"}], ")"}], "/", "2"}], "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{"J", "+", "1"}], ")"}]}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"J", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"d", "-", "1"}], ")"}], "/", "2"}]}], "]"}], 
       RowBox[{"z", "^", 
        RowBox[{"(", 
         RowBox[{"J", "+", "1"}], ")"}]}]}], ")"}]}], " ", 
    RowBox[{"Hypergeometric2F1", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"J", "+", "1"}], ")"}], "/", "2"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"J", "+", "2"}], ")"}], "/", "2"}], ",", " ", 
      RowBox[{"J", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"d", "-", "1"}], ")"}], "/", "2"}]}], ",", 
      RowBox[{"1", "/", 
       RowBox[{"z", "^", "2"}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PolQDer", "[", 
    RowBox[{"J_", ",", "d_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
