Cell["\<\
Use secant method of order 2 for optimised computation (one integral per \
step). First order method to get 3rd point of initialisation.\
\>", "Text",
 CellChangeTimes->{{3.991750848408045*^9, 
  3.991750915134922*^9}},ExpressionUUID->"5f847a7e-d020-440c-9cad-\
e5b79c7ff628"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "secantOrder2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"secantOrder2", "[", 
    RowBox[{"myFunc_", ",", "start_", ",", 
     RowBox[{"nmax_", ":", "100"}], ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "x0", ",", "x1", ",", "x2", ",", " ", "x3", ",", "i", ",", "a", ",", 
       "b", ",", "c"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"x0", "=", "start"}], ";", "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{"myFunc", "[", "x0", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x1", " ", "=", " ", 
       RowBox[{"start", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", "I"}], ")"}], 
         SuperscriptBox["10", 
          RowBox[{"-", "4"}]]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"myFunc", "[", "x1", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x2", "=", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x1", " ", "b"}], "-", 
          RowBox[{"x0", " ", "c"}]}], ")"}], 
        RowBox[{"b", "-", " ", "c"}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{"i", "=", "0"}], ";", "\[IndentingNewLine]", "\n", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "=", "b"}], ";", "\[IndentingNewLine]", 
         RowBox[{"b", "=", "c"}], ";", "\[IndentingNewLine]", 
         RowBox[{"c", "=", 
          RowBox[{"myFunc", "[", "x2", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "c", "]"}], ">", "tol"}], "&&", 
          RowBox[{"i", "<", "nmax"}], "&&", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"i", "<", "3"}], "||", 
            RowBox[{
             RowBox[{"Abs", "[", "b", "]"}], ">", 
             RowBox[{"Abs", "[", "c", "]"}]}]}], ")"}], "&&", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"x2", "-", "start"}], "]"}], "<", "0.4"}]}]}], ",", 
        RowBox[{
         RowBox[{"i", "=", 
          RowBox[{"i", "+", "1"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"x3", "=", 
          RowBox[{
           FractionBox[
            RowBox[{"x0", " ", "b", " ", "c"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"a", "-", "b"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"a", "-", "c"}], ")"}]}]], "+", 
           FractionBox[
            RowBox[{"x1", " ", "a", " ", "c"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"b", "-", "a"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"b", "-", "c"}], ")"}]}]], "+", 
           FractionBox[
            RowBox[{"x2", " ", "a", " ", "b"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"c", "-", "a"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"c", "-", "b"}], ")"}]}]]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"x0", "=", "x1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"x1", "=", "x2"}], ";", "\[IndentingNewLine]", 
         RowBox[{"x2", "=", "x3"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"x2", "-", "start"}], "]"}], ">", "0.4"}], ",", 
        RowBox[{"x2", "=", "start"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "x2"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9893819945914288`*^9, 3.989382035142722*^9}, {
   3.9893821278292217`*^9, 3.989382509371237*^9}, {3.9893825984029217`*^9, 
   3.9893827543383713`*^9}, {3.989382787437332*^9, 3.989382822878818*^9}, {
   3.989382879472719*^9, 3.98938288001615*^9}, {3.9893832584366207`*^9, 
   3.9893832628000937`*^9}, {3.989383365184929*^9, 3.9893833826057663`*^9}, {
   3.989383476408164*^9, 3.989383487535718*^9}, {3.989383767065958*^9, 
   3.989383782224674*^9}, {3.98938393906225*^9, 3.98938394036541*^9}, 
   3.989389274552321*^9, 3.9893896741832943`*^9, {3.989390074350141*^9, 
   3.989390076800255*^9}, 3.9893901633087807`*^9},
