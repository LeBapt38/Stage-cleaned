    RowBox[{"(", 
     RowBox[{"with", " ", "rho", " ", "ansatz"}], ")"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"exprJmain1", "[", 
    RowBox[{"J_", ",", "s_"}], "]"}], ":=", 
   RowBox[{"MyNIntegrateFaster", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"PolQ", "[", 
         RowBox[{"J", ",", "d", ",", "z"}], "]"}], 
