Cell[CellGroupData[{

Cell["Computation rho ansatz deep s domain int compactified", "Section",
 CellChangeTimes->{{3.990694903356497*^9, 3.990694917006896*^9}, {
  3.9907587540646133`*^9, 
  3.990758762983461*^9}},ExpressionUUID->"44d13b54-d235-43b1-ab8a-\
c12d8f676472"],

Cell["\<\
The relatively low precision of half infinite domain and the hardship of \
looking at the tail on an angled branch cut means compactifying the integral \
might be the most effective pass.\
\>", "Text",
 CellChangeTimes->{{3.9917486556432123`*^9, 
  3.9917487369357643`*^9}},ExpressionUUID->"e9845dba-9387-48aa-92f0-\
84d763bd0129"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"exprSTU", ",", "expr", ",", "DiscExprT", ",", "DiscExprU"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exprSTU", "[", 
    RowBox[{"s_", ",", "t_", ",", "u_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"rho", "[", "s", "]"}], "+", 
    RowBox[{"rho", "[", "t", "]"}], "+", 
    RowBox[{"rho", "[", "u", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"expr", "[", 
    RowBox[{"s_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"exprSTU", "[", 
    RowBox[{"s", ",", " ", 
     RowBox[{"tt", "[", 
      RowBox[{"s", ",", "z"}], "]"}], ",", 
     RowBox[{"uu", "[", 
      RowBox[{"s", ",", "z"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DiscExprT", "[", 
   RowBox[{"s_", ",", "z_"}], "]"}], ":=", 
  RowBox[{"rhoT", "[", 
   RowBox[{"tt", "[", 
    RowBox[{"s", ",", "z"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DiscExprU", "[", 
   RowBox[{"s_", ",", "z_"}], "]"}], ":=", 
  RowBox[{"rhoT", "[", 
   RowBox[{"uu", "[", 
    RowBox[{"s", ",", "z"}], "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.990694976736315*^9, 3.9906949990005293`*^9}},
 CellLabel->
