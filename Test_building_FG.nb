Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"exprSTU", ",", "expr", ",", "DiscExprT", ",", "DiscExprU"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exprSTU", "[", 
    RowBox[{"s_", ",", "t_", ",", "u_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"rho", "[", "s", "]"}], "+", 
    RowBox[{"rho", "[", "t", "]"}], "+", 
    RowBox[{"rho", "[", "u", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"expr", "[", 
    RowBox[{"s_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"exprSTU", "[", 
    RowBox[{"s", ",", " ", 
     RowBox[{"tt", "[", 
      RowBox[{"s", ",", "z"}], "]"}], ",", 
     RowBox[{"uu", "[", 
      RowBox[{"s", ",", "z"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DiscExprT", "[", 
   RowBox[{"s_", ",", "z_"}], "]"}], ":=", 
  RowBox[{"rhoT", "[", 
   RowBox[{"tt", "[", 
    RowBox[{"s", ",", "z"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DiscExprU", "[", 
   RowBox[{"s_", ",", "z_"}], "]"}], ":=", 
  RowBox[{"rhoT", "[", 
   RowBox[{"uu", "[", 
    RowBox[{"s", ",", "z"}], "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.990694976736315*^9, 3.9906949990005293`*^9}},
