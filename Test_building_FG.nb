 RowBox[{
  RowBox[{
   RowBox[{"HalfCompactify", "[", 
    RowBox[{"s0_", ",", "\[Phi]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", " ", "s0"}], ")"}], "/", 
