Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "MyNIntegrateFaster", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MyNIntegrateFaster", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "a_", ",", "b_"}], "}"}], ",", "p_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"temp", "=", "expr"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<integrate...\>\"", "]"}], ";"}], "*)"}], 
     RowBox[{
      RowBox[{"temp", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"temp", ",", 
         RowBox[{"8", "*", "p"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"temp", "=", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{"temp", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
         RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}], ",", 
         RowBox[{"WorkingPrecision", "->", 
          RowBox[{"4", "*", "p"}]}], ",", 
         RowBox[{"PrecisionGoal", "->", "p"}], ",", 
         RowBox[{"AccuracyGoal", "->", "p"}], ",", 
         RowBox[{"MaxRecursion", "->", "100"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"temp", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"temp", ",", "p"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "temp", "]"}], ";"}]}], "]"}]}], ";"}]}], "Input",\

