Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"exprJmain1", ",", "exprJmain2"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p0", "=", "8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"exprJmain1", "[", 
    RowBox[{"J_", ",", "s_"}], "]"}], ":=", 
   RowBox[{"MyNIntegrateFaster", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"PolQ", "[", 
       RowBox[{"J", ",", "d", ",", "z"}], "]"}], 
      RowBox[{"DiscExprT", "[", 
       RowBox[{"s", ",", "z"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", " ", 
       RowBox[{"z0t", "[", "s", "]"}], ",", "Infinity"}], "}"}], ",", "p0"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exprJmain2", "[", 
    RowBox[{"J_", ",", "s_"}], "]"}], ":=", 
   RowBox[{"MyNIntegrateFaster", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"PolQ", "[", 
       RowBox[{"J", ",", "d", ",", "z"}], "]"}], 
      RowBox[{"DiscExprU", "[", 
       RowBox[{"s", ",", "z"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", " ", 
       RowBox[{"z0u", "[", "s", "]"}], ",", "Infinity"}], "}"}], ",", "p0"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exprJ", "[", 
   RowBox[{"J_", ",", "s_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Re", "[", "s", "]"}], ">", "4"}], ",", 
    RowBox[{"exprJmain1", "[", 
     RowBox[{"J", ",", "s"}], "]"}], ",", 
    RowBox[{"exprJmain2", "[", 
     RowBox[{"J", ",", "s"}], "]"}]}], "]"}]}]}], "Input",
