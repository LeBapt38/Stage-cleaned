Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"exprJmain1", ",", "exprJmain2"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p0", "=", "8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"exprJmain1", "[", 
    RowBox[{"J_", ",", "s_"}], "]"}], ":=", 
   RowBox[{"MyNIntegrateFaster", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"PolQ", "[", 
         RowBox[{"J", ",", "d", ",", "z"}], "]"}], 
        RowBox[{"DiscExprT", "[", 
         RowBox[{"s", ",", "z"}], "]"}]}], ")"}], "//", 
      RowBox[{
       RowBox[{"CompactIntegrand", "[", 
        RowBox[{"#", ",", "z", ",", 
         RowBox[{"z0t", "[", "s", "]"}]}], "]"}], "&"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", "0", ",", "\[Pi]"}], "}"}], ",", "p0"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exprJmain2", "[", 
    RowBox[{"J_", ",", "s_"}], "]"}], ":=", 
   RowBox[{"MyNIntegrateFaster", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"PolQ", "[", 
         RowBox[{"J", ",", "d", ",", "z"}], "]"}], 
        RowBox[{"DiscExprU", "[", 
         RowBox[{"s", ",", "z"}], "]"}]}], ")"}], "//", 
      RowBox[{
       RowBox[{"CompactIntegrand", "[", 
        RowBox[{"#", ",", "z", ",", 
         RowBox[{"z0u", "[", "s", "]"}]}], "]"}], "&"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", "0", ",", "\[Pi]"}], "}"}], ",", "p0"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exprJ", "[", 
   RowBox[{"J_", ",", "s_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Re", "[", "s", "]"}], ">", "4"}], ",", 
    RowBox[{"exprJmain1", "[", 
     RowBox[{"J", ",", "s"}], "]"}], ",", 
    RowBox[{"exprJmain2", "[", 
     RowBox[{"J", ",", "s"}], "]"}]}], "]"}]}]}], "Input",
