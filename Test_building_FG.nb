 RowBox[{
  RowBox[{
   RowBox[{"Pgen", "[", 
    RowBox[{"J_", ",", "d_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"GegenbauerC", "[", 
      RowBox[{"J", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"d", "-", "3"}], ")"}], "/", "2"}], ",", "z"}], "]"}], "/", 
     RowBox[{"GegenbauerC", "[", 
