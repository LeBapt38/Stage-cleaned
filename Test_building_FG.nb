Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"iQInfinity12", ",", "tail"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"iQInfinity12", "[", 
   RowBox[{"start_", ",", " ", "J_", ",", " ", "d_"}], "]"}], "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"PolQ", "[", 
      RowBox[{"J", ",", "d", ",", "z"}], "]"}], 
     FractionBox["1", 
      SuperscriptBox["z", 
       RowBox[{"1", "/", "2"}]]]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"z", ",", " ", "start", ",", " ", "Infinity"}], "}"}], ",", " ", 
    
    RowBox[{"GenerateConditions", "->", "False"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tail", "[", 
   RowBox[{
   "amplitudeT_", ",", " ", "s_", ",", " ", "J_", ",", " ", "d_", ",", " ", 
    "start_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"zvals", ",", " ", "yvals", ",", " ", "coeff12"}], "}"}], ",", 
    "\[IndentingNewLine]", "\t\t\t\t\t\t\t\t", 
    RowBox[{
     RowBox[{"zvals", " ", "=", " ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"start", "[", "s", "]"}], "]"}], "*", 
       RowBox[{"{", 
        RowBox[{"100000", ",", "1000000", ",", " ", "10000000"}], "}"}]}]}], ";",
      "\[IndentingNewLine]", "\t\t\t\t\t\t\t\t", 
     RowBox[{"yvals", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"amplitudeT", "[", 
         RowBox[{"s", ",", "#"}], "]"}], "&"}], "/@", "zvals"}]}], ";", 
     "\[IndentingNewLine]", "\t\t\t\t\t\t\t\t", 
     RowBox[{"coeff12", "=", 
      RowBox[{"Mean", "[", 
       RowBox[{"yvals", "*", 
        RowBox[{"zvals", "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\t\t\t\t\t\t\t\t", 
     RowBox[{
      RowBox[{"iQInfinity12", "[", 
       RowBox[{
        RowBox[{"50000", 
         RowBox[{"Abs", "[", 
          RowBox[{"start", "[", "s", "]"}], "]"}]}], ",", " ", "J", ",", " ", 
        "d"}], "]"}], "coeff12"}]}]}], "]"}]}]}], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"3ee38a2c-29c3-4388-ba11-6d6e03b1297e"],

